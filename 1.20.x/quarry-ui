local byKey = {}
for _, f in ipairs(fields) do byKey[f.key] = f end
local byLower = {}
for _, f in ipairs(fields) do byLower[f.key:lower()] = f end
local function get(key) return byKey[key] end
local function val(key) return byKey[key].value end
local function setVal(key, v) byKey[key].value = v end

local pageTitles = {"Size", "Direction", "Fuel", "Chest and inventory", "Ore", "Network and GPS", "Logging and resume", "Recovery"}
local function fieldsOnPage(p)
  local out = {}
  for _, f in ipairs(fields) do if f.page == p then out[#out + 1] = f end end
  return out
end
