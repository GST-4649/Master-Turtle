-- quarry-ui: preset builder and TUI for the Master Turtle quarry.
-- Wrapper only. It writes current-preset.txt, then runs quarry with
-- that preset. It never edits quarry, and it never edits its save file.
-- Plain term UI, so it works standalone and from the Master Turtle
-- launcher, on a normal turtle with keyboard only and on an advanced
-- turtle with mouse clicks and color. Lua 5.1 clean: no goto, no
-- integer division operator, no native bitwise operators.
local unpack = table.unpack or unpack

local W, H = term.getSize()
local isColor = false
if term.isColor then isColor = term.isColor() end

local function col(name)
  if isColor then return colors[name] or colors.white end
  if name == "black" then return colors.black end
  if name == "gray" or name == "lightGray" then return colors.lightGray end
  return colors.white
end

local function setFG(name) term.setTextColor(col(name)) end
local function setBG(name) term.setBackgroundColor(col(name)) end
local function clearAll() setBG("black") setFG("white") term.clear() term.setCursorPos(1, 1) end
local function put(x, y, text, fg, bg)
  if x < 1 or y < 1 or y > H then return end
  term.setCursorPos(x, y)
  if fg then setFG(fg) end
  if bg then setBG(bg) end
  term.write(text)
end
local function center(y, text, fg)
  local x = math.floor((W - #text) / 2) + 1
  if x < 1 then x = 1 end
  put(x, y, text, fg, "black")
end
local function trim(s) return (tostring(s or "")):gsub("^%s+", ""):gsub("%s+$", "") end
local function clamp(n, lo, hi)
  if lo and n < lo then return lo end
  if hi and n > hi then return hi end
  return n
end

-- Field model. kind: bool, boolForce, number, float, string.
-- page: 1 Size, 2 Direction, 3 Fuel, 4 Chest, 5 Ore, 6 Network, 7 Logging, 8 Recovery.
-- def: quarry default. For send/receive/maxFuel/startY/startDown, 0 means auto or unset.
local fields = {}
local function F(key, label, flag, kind, page, def, minv, maxv, step)
  local f = {key = key, label = label, flag = flag, kind = kind, page = page, def = def, value = def, minv = minv, maxv = maxv, step = step or 1}
  fields[#fields + 1] = f
  return f
end

