  drawHeader("Info: what the flags do")
  local visible = H - 5
  if visible < 1 then visible = 1 end
  if infoScroll < 0 then infoScroll = 0 end
  if infoScroll > math.max(0, #helpLines - visible) then infoScroll = math.max(0, #helpLines - visible) end
  for i = infoScroll + 1, math.min(#helpLines, infoScroll + visible) do
    local y = 3 + (i - infoScroll - 1)
    put(2, y, helpLines[i]:sub(1, W - 2), "white", "black")
  end
  local btns = {{x = 2, y = H - 1, label = "[Back]", bg = "gray", action = "back"}}
  drawFooter("Up/Down scroll, Esc back", btns)
  return btns
end

local function drawModeQuick()
  drawHeader("Quarry UI")
  center(4, "Use last mode: " .. (modeNames[lastMode] or ""), "white")
  center(5, "Press Enter to use it, or C to change it.", "lightGray")
  local btns = {
    {x = 12, y = 7, label = "[Use last]", bg = "lime", action = "use"},
    {x = 26, y = 7, label = "[Change]", bg = "gray", action = "change"},
  }
  drawFooter("Enter use, C change, Q quit", btns)
  return btns
end

local function drawModeSelect()
  drawHeader("Choose a mode")
  local rows = {"Easy: pages 1, 2, 5", "Advanced: pages 1, 2, 3, 5, 6", "Total control: all pages", "Old: original quarry, no TUI", "Load preset", "Info", "Quit"}
  if modeSel < 1 then modeSel = 1 end
  if modeSel > #rows then modeSel = #rows end
  for i, row in ipairs(rows) do
    local bg = (i == modeSel) and "lightGray" or "black"
    put(2, 3 + i, row, "white", bg)
  end
  drawFooter("Up/Down select, Enter choose, Q quit", nil)
  return rows
end

local function drawLoad()
  drawHeader("Load preset")
  if #loadList == 0 then put(2, 4, "No named presets found.", "lightGray", "black") end
  if loadSel < 1 then loadSel = 1 end
  if loadSel > #loadList then loadSel = #loadList end
  for i, name in ipairs(loadList) do
    local bg = (i == loadSel) and "lightGray" or "black"
    put(2, 3 + i, name, "white", bg)
  end
  drawFooter("Up/Down select, Enter load, Esc back", nil)
end

local function drawSave()
  drawHeader("Save as preset")
  put(2, 4, "Preset name (no spaces):", "white", "black")
  local txt = saveName
  if saveEditing then txt = txt .. "_" end
  put(2, 5, txt, "white", "black")
  local btns = {
    {x = 2, y = H - 1, label = "[Save]", bg = "lime", action = "save"},
    {x = 11, y = H - 1, label = "[Cancel]", bg = "gray", action = "cancel"},
  }
  drawFooter("Type a name, Enter save, Esc cancel", btns)
  return btns
end

local function launchQuarry(args)
  clearAll()
  put(1, 1, "Starting quarry...", "white", "black")
  local ok, err = shell.run("quarry", unpack(args))
  if not ok then
    errorMsg = "Quarry failed: " .. tostring(err)
    return false
  end
  return true
end

local function doStart()
  if not writePreset("current-preset.txt") then
    errorMsg = "Could not write current-preset.txt"
    return false
  end
  return launchQuarry({"-file", "current-preset.txt", "-default"})
end

local function isKey(ev, name, code)
  if keys and keys[name] then return ev[2] == keys[name] end
  return ev[2] == code
end
local function buttonAt(btns, x, y)
  if not btns then return nil end
  for _, b in ipairs(btns) do
    if y == b.y and x >= b.x and x < b.x + #b.label then return b.action end
  end
  return nil
end
local function moveSelection(dir)
  local pfields = currentPageFields()
  local i = fieldSel + dir
  while i >= 1 and i <= #pfields and not fieldEnabled(pfields[i]) do i = i + dir end
  if i >= 1 and i <= #pfields then fieldSel = i end
end

while true do
  local btns = nil
  if screen == "resume" then
    clearAll()
    center(4, "QUARRY UI", "yellow")
    center(6, "Resuming quarry run...", "white")
    center(7, "Press any key to stop and choose a mode.", "lightGray")
    center(8, "Resuming in 5 seconds if you do nothing.", "lightGray")
  elseif screen == "modeQuick" then btns = drawModeQuick()
  elseif screen == "modeSelect" then drawModeSelect()
  elseif screen == "page" then btns = drawPage()
  elseif screen == "summary" then btns = drawSummary()
  elseif screen == "info" then btns = drawInfo()
  elseif screen == "load" then drawLoad()
  elseif screen == "save" then btns = drawSave()
  end

  local ev = {os.pullEvent()}
  local etype = ev[1]
  local done = false

  if screen == "resume" then
    if etype == "timer" and ev[2] == resumeTimer then
      if launchQuarry({"-resume"}) then break end
      screen = lastMode and "modeQuick" or "modeSelect"
    elseif etype == "key" or etype == "char" or etype == "mouse_click" then
      screen = lastMode and "modeQuick" or "modeSelect"
    end
  elseif screen == "modeQuick" then
    if etype == "key" and isKey(ev, "enter", 28) then
      if lastMode == "old" then
        setMode("old")
        if launchQuarry({}) then break end
        screen = "modeSelect"
      else
        setMode(lastMode)
        screen = "page"
      end
    elseif etype == "char" and ev[2]:lower() == "c" then
      screen = "modeSelect" modeSel = 1
    elseif etype == "char" and ev[2]:lower() == "q" then break
    elseif etype == "key" and isKey(ev, "esc", 1) then break
    elseif etype == "mouse_click" then
      local act = buttonAt(btns, ev[3], ev[4])
      if act == "use" then
        if lastMode == "old" then
          setMode("old")
          if launchQuarry({}) then break end
          screen = "modeSelect"
        else
          setMode(lastMode)
          screen = "page"
        end
      elseif act == "change" then screen = "modeSelect" modeSel = 1 end
    end
  elseif screen == "modeSelect" then
    if etype == "key" and isKey(ev, "up", 200) then modeSel = modeSel - 1
    elseif etype == "key" and isKey(ev, "down", 208) then modeSel = modeSel + 1
    elseif etype == "key" and isKey(ev, "enter", 28) then
      if modeSel == 1 then setMode("easy") screen = "page"
      elseif modeSel == 2 then setMode("advanced") screen = "page"
      elseif modeSel == 3 then setMode("total") screen = "page"
      elseif modeSel == 4 then
        setMode("old")
        if launchQuarry({}) then break end
        screen = "modeSelect"
      elseif modeSel == 5 then loadList = listPresets() loadSel = 1 screen = "load"
      elseif modeSel == 6 then returnScreen = "modeSelect" screen = "info" infoScroll = 0
      elseif modeSel == 7 then break end
    elseif etype == "char" and ev[2]:lower() == "q" then break
    elseif etype == "key" and isKey(ev, "esc", 1) then break
    elseif etype == "mouse_click" then
      local row = ev[4] - 3
      if row >= 1 and row <= 7 then
        modeSel = row
        if row == 1 then setMode("easy") screen = "page"
        elseif row == 2 then setMode("advanced") screen = "page"
        elseif row == 3 then setMode("total") screen = "page"
        elseif row == 4 then
          setMode("old")
          if launchQuarry({}) then break end
          screen = "modeSelect"
        elseif row == 5 then loadList = listPresets() loadSel = 1 screen = "load"
        elseif row == 6 then returnScreen = "modeSelect" screen = "info" infoScroll = 0
        elseif row == 7 then break end
      end
    end
  elseif screen == "page" then
    local pfields = currentPageFields()
    local f = pfields[fieldSel]
    if editField then
      if etype == "char" then
        local ch = ev[2]
        if editField.kind == "number" or editField.kind == "float" then
          if ch:match("[%d%.]") and #editBuffer < 12 then editBuffer = editBuffer .. ch end
        elseif editField.kind == "string" then
          if ch:match("[%w%./]") and #editBuffer < 24 then editBuffer = editBuffer .. ch end
        end
      elseif etype == "key" and isKey(ev, "backspace", 14) then editBuffer = editBuffer:sub(1, -2)
      elseif etype == "key" and isKey(ev, "enter", 28) then finishEdit(true)
      elseif etype == "key" and isKey(ev, "esc", 1) then finishEdit(false)
      elseif etype == "key" and isKey(ev, "up", 200) then finishEdit(true) moveSelection(-1)
      elseif etype == "key" and isKey(ev, "down", 208) then finishEdit(true) moveSelection(1)
      elseif etype == "mouse_click" then
        finishEdit(true)
        local act = buttonAt(btns, ev[3], ev[4])
        if act == "back" then
          if pageIdx > 1 then pageIdx = pageIdx - 1 fieldSel = 1 else screen = lastMode and "modeQuick" or "modeSelect" end
        elseif act == "info" then returnScreen = "page" screen = "info" infoScroll = 0
        elseif act == "next" then
          if pageIdx < #pages then pageIdx = pageIdx + 1 fieldSel = 1 else screen = "summary" summaryScroll = 0 end
        else
          local row = ev[4] - 2 + pageScroll
          if row >= 1 and row <= #pfields then
            local nf = pfields[row]
            if fieldEnabled(nf) then
              fieldSel = row
              if nf.kind == "bool" or nf.kind == "boolForce" then nf.value = not nf.value applyToggles() errorMsg = ""
              elseif nf.kind == "number" or nf.kind == "float" then
                local mx = W - 8
                local px = W - 4
                if ev[3] >= mx and ev[3] < mx + 3 then nf.value = clamp(nf.value - nf.step, nf.minv, nf.maxv)
                elseif ev[3] >= px and ev[3] < px + 3 then nf.value = clamp(nf.value + nf.step, nf.minv, nf.maxv)
                else editField = nf editBuffer = tostring(nf.value) end
              else editField = nf editBuffer = tostring(nf.value) end
            end
          end
        end
      end
    else
      if etype == "key" and isKey(ev, "up", 200) then moveSelection(-1)
      elseif etype == "key" and isKey(ev, "down", 208) then moveSelection(1)
      elseif etype == "key" and isKey(ev, "enter", 28) then
        if f and fieldEnabled(f) then
          if f.kind == "bool" or f.kind == "boolForce" then f.value = not f.value applyToggles() errorMsg = ""
          else editField = f editBuffer = tostring(f.value) end
        end
      elseif etype == "char" and ev[2] == " " then
        if f and fieldEnabled(f) and (f.kind == "bool" or f.kind == "boolForce") then f.value = not f.value applyToggles() errorMsg = "" end
      elseif etype == "char" and ev[2] == "+" then
        if f and fieldEnabled(f) and (f.kind == "number" or f.kind == "float") then f.value = clamp(f.value + f.step, f.minv, f.maxv) end
      elseif etype == "char" and ev[2] == "-" then
        if f and fieldEnabled(f) and (f.kind == "number" or f.kind == "float") then f.value = clamp(f.value - f.step, f.minv, f.maxv) end
      elseif etype == "char" and ev[2]:lower() == "n" then
        if pageIdx < #pages then pageIdx = pageIdx + 1 fieldSel = 1 else screen = "summary" summaryScroll = 0 end
      elseif etype == "key" and isKey(ev, "tab", 15) then
        if pageIdx < #pages then pageIdx = pageIdx + 1 fieldSel = 1 else screen = "summary" summaryScroll = 0 end
      elseif etype == "char" and ev[2]:lower() == "b" then
        if pageIdx > 1 then pageIdx = pageIdx - 1 fieldSel = 1 else screen = lastMode and "modeQuick" or "modeSelect" end
      elseif etype == "char" and ev[2]:lower() == "i" then returnScreen = "page" screen = "info" infoScroll = 0
      elseif etype == "key" and isKey(ev, "esc", 1) then
        if pageIdx > 1 then pageIdx = pageIdx - 1 fieldSel = 1 else screen = lastMode and "modeQuick" or "modeSelect" end
      elseif etype == "char" and f and fieldEnabled(f) and (f.kind == "number" or f.kind == "float") and ev[2]:match("[%d%.]") then
        editField = f editBuffer = ev[2]
      elseif etype == "char" and f and fieldEnabled(f) and f.kind == "string" and ev[2]:match("[%w%./]") then
        editField = f editBuffer = ev[2]
      elseif etype == "mouse_click" then
        local act = buttonAt(btns, ev[3], ev[4])
        if act == "back" then
          if pageIdx > 1 then pageIdx = pageIdx - 1 fieldSel = 1 else screen = lastMode and "modeQuick" or "modeSelect" end
        elseif act == "info" then returnScreen = "page" screen = "info" infoScroll = 0
        elseif act == "next" then
          if pageIdx < #pages then pageIdx = pageIdx + 1 fieldSel = 1 else screen = "summary" summaryScroll = 0 end
        else
          local row = ev[4] - 2 + pageScroll
          if row >= 1 and row <= #pfields then
            local nf = pfields[row]
            if fieldEnabled(nf) then
              fieldSel = row
              if nf.kind == "bool" or nf.kind == "boolForce" then nf.value = not nf.value applyToggles() errorMsg = ""
              elseif nf.kind == "number" or nf.kind == "float" then
                local mx = W - 8
                local px = W - 4
                if ev[3] >= mx and ev[3] < mx + 3 then nf.value = clamp(nf.value - nf.step, nf.minv, nf.maxv)
                elseif ev[3] >= px and ev[3] < px + 3 then nf.value = clamp(nf.value + nf.step, nf.minv, nf.maxv)
                else editField = nf editBuffer = tostring(nf.value) end
              else editField = nf editBuffer = tostring(nf.value) end
            end
          end
        end
      end
    end
  elseif screen == "summary" then
    if etype == "key" and isKey(ev, "up", 200) then summaryScroll = summaryScroll - 1
    elseif etype == "key" and isKey(ev, "down", 208) then summaryScroll = summaryScroll + 1
    elseif etype == "mouse_scroll" then summaryScroll = summaryScroll + ev[2]
    elseif etype == "char" and ev[2]:lower() == "s" then
      if doStart() then break end
    elseif etype == "char" and ev[2]:lower() == "b" then screen = "page"
    elseif etype == "char" and ev[2]:lower() == "p" then screen = "save" saveName = "" saveEditing = true
    elseif etype == "char" and ev[2]:lower() == "i" then returnScreen = "summary" screen = "info" infoScroll = 0
    elseif etype == "key" and isKey(ev, "esc", 1) then screen = "page"
    elseif etype == "mouse_click" then
      local act = buttonAt(btns, ev[3], ev[4])
      if act == "start" then
        if doStart() then break end
      elseif act == "back" then screen = "page"
      elseif act == "save" then screen = "save" saveName = "" saveEditing = true
      elseif act == "info" then returnScreen = "summary" screen = "info" infoScroll = 0 end
    end
  elseif screen == "info" then
    if etype == "key" and isKey(ev, "up", 200) then infoScroll = infoScroll - 1
    elseif etype == "key" and isKey(ev, "down", 208) then infoScroll = infoScroll + 1
    elseif etype == "mouse_scroll" then infoScroll = infoScroll + ev[2]
    elseif etype == "key" and isKey(ev, "esc", 1) then screen = returnScreen
    elseif etype == "char" and ev[2]:lower() == "b" then screen = returnScreen
    elseif etype == "char" and ev[2]:lower() == "q" then screen = returnScreen
    elseif etype == "mouse_click" then
      local act = buttonAt(btns, ev[3], ev[4])
      if act == "back" then screen = returnScreen end
    end
  elseif screen == "load" then
    if etype == "key" and isKey(ev, "up", 200) then loadSel = loadSel - 1
    elseif etype == "key" and isKey(ev, "down", 208) then loadSel = loadSel + 1
    elseif etype == "key" and isKey(ev, "enter", 28) then
      if loadList[loadSel] and loadPreset(loadList[loadSel]) then
        if lastMode and lastMode ~= "old" then setMode(lastMode) screen = "page" else screen = "modeSelect" end
      else errorMsg = "Could not load preset" screen = "modeSelect" end
    elseif etype == "key" and isKey(ev, "esc", 1) then screen = "modeSelect"
    elseif etype == "char" and ev[2]:lower() == "b" then screen = "modeSelect"
    elseif etype == "mouse_click" then
      local row = ev[4] - 3
      if row >= 1 and row <= #loadList then
        loadSel = row
        if loadPreset(loadList[row]) then
          if lastMode and lastMode ~= "old" then setMode(lastMode) screen = "page" else screen = "modeSelect" end
        else errorMsg = "Could not load preset" screen = "modeSelect" end
      end
    end
  elseif screen == "save" then
    if etype == "char" and ev[2]:match("[%w%._%-]") and #saveName < 24 then saveName = saveName .. ev[2]
    elseif etype == "key" and isKey(ev, "backspace", 14) then saveName = saveName:sub(1, -2)
    elseif etype == "key" and isKey(ev, "enter", 28) then
      local name = trim(saveName)
      if name == "" then errorMsg = "Enter a preset name" screen = "summary"
      elseif name == "current-preset" then errorMsg = "That name is reserved" screen = "summary"
      else
        if name:sub(-4) ~= ".txt" then name = name .. ".txt" end
        if writePreset(name) then errorMsg = "" screen = "summary" else errorMsg = "Could not write preset" screen = "summary" end
      end
      saveEditing = false
    elseif etype == "key" and isKey(ev, "esc", 1) then saveEditing = false screen = "summary"
    elseif etype == "mouse_click" then
      local act = buttonAt(btns, ev[3], ev[4])
      if act == "cancel" then saveEditing = false screen = "summary"
      elseif act == "save" then
        local name = trim(saveName)
        if name == "" then errorMsg = "Enter a preset name" screen = "summary"
        elseif name == "current-preset" then errorMsg = "That name is reserved" screen = "summary"
        else
          if name:sub(-4) ~= ".txt" then name = name .. ".txt" end
          if writePreset(name) then errorMsg = "" screen = "summary" else errorMsg = "Could not write preset" screen = "summary" end
        end
        saveEditing = false
      end
    end
  end
end

clearAll()
setFG("white")
