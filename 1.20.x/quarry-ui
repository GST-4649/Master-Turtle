local function currentPageFields()
  local p = pages[pageIdx] or 1
  return fieldsOnPage(p)
end

local function setMode(m)
  mode = m
  if m == "old" then
    pages = {}
  else
    pages = modePages[m]
  end
  pageIdx = 1
  fieldSel = 1
  pageScroll = 0
  writeFile("quarry-ui-last-mode.txt", {m})
end

local function summaryLines()
  local out = {}
  out[#out + 1] = "Size: " .. tostring(val("length")) .. " by " .. tostring(val("width")) .. " by " .. tostring(val("height")) .. " (-dim)"
  for _, f in ipairs(fields) do
    if f.key ~= "length" and f.key ~= "width" and f.key ~= "height" then
      if f.value ~= f.def then
        if f.kind == "boolForce" then
          if f.value then out[#out + 1] = f.label .. " = on (" .. f.flag .. ")" end
        else
          out[#out + 1] = f.label .. " = " .. tostring(f.value) .. " (" .. f.flag .. ")"
        end
      end
    end
  end
  if #out == 1 then out[#out + 1] = "All other values are quarry defaults." end
  if val("atChest") and not saveFound then out[#out + 1] = "Warning: At chest is on but no save file was found at start." end
  return out
end

local function drawButtons(btns)
  for _, b in ipairs(btns) do
    put(b.x, b.y, b.label, b.fg or "black", b.bg or "lime")
  end
  return btns
end

local function drawHeader(title)
  clearAll()
  center(1, "QUARRY UI", "yellow")
  center(2, title, "white")
end

local function drawFooter(hint, btns)
  if errorMsg ~= "" then put(1, H - 2, errorMsg:sub(1, W), "red", "black") end
  if btns then drawButtons(btns) end
  if hint then put(1, H, hint:sub(1, W), "lightGray", "black") end
end

local function finishEdit(accept)
  local f = editField
  editField = nil
  if not f or not accept then editBuffer = "" return end
  local buf = trim(editBuffer)
  editBuffer = ""
  if f.kind == "number" or f.kind == "float" then
    local n = tonumber(buf)
    if not n then errorMsg = "Enter a number for " .. f.label return end
    if f.kind == "number" then n = math.floor(n) end
    if (f.minv and n < f.minv) or (f.maxv and n > f.maxv) then errorMsg = "Out of range for " .. f.label return end
    f.value = n
    errorMsg = ""
  elseif f.kind == "string" then
    if buf == "" then
      if f.key == "logExtension" then f.value = "" errorMsg = "" else errorMsg = "Enter a value for " .. f.label end
      return
    end
    if not buf:match("^[%w%./]+$") then errorMsg = "Use letters, numbers, dot or slash for " .. f.label return end
    f.value = buf
    errorMsg = ""
  end
  applyToggles()
end

local function drawPage()
  local pfields = currentPageFields()
  local title = "Mode: " .. (modeNames[mode] or "") .. "  Page " .. tostring(pageIdx) .. " of " .. tostring(#pages) .. ": " .. pageTitles[pages[pageIdx] or 1]
  drawHeader(title)
  local visible = H - 5
  if visible < 1 then visible = 1 end
  if fieldSel < 1 then fieldSel = 1 end
  if fieldSel > #pfields then fieldSel = #pfields end
  if fieldSel <= pageScroll then pageScroll = fieldSel - 1 end
  if fieldSel > pageScroll + visible then pageScroll = fieldSel - visible end
  for i = pageScroll + 1, math.min(#pfields, pageScroll + visible) do
    local f = pfields[i]
    local y = 3 + (i - pageScroll - 1)
    local sel = (i == fieldSel)
    local bg = sel and "lightGray" or "black"
    local fg = "white"
    if not fieldEnabled(f) then fg = "gray" end
    put(2, y, f.label, fg, bg)
    local vx = 30
    if f.kind == "bool" or f.kind == "boolForce" then
      put(vx, y, displayValue(f), f.value and "green" or "gray", bg)
    else
      local vtext = displayValue(f)
      if editField == f then vtext = editBuffer .. "_" end
      put(vx, y, vtext, fg, bg)
      if f.kind == "number" or f.kind == "float" then
        local mx = W - 8
        local px = W - 4
        if mx > vx + 2 then
          put(mx, y, "[-]", "white", bg)
          put(px, y, "[+]", "white", bg)
        end
      end
    end
  end
  local nextLabel = "Next"
  if pageIdx >= #pages then nextLabel = "Summary" end
  local btns = {
    {x = 2, y = H - 1, label = "[Back]", bg = "gray", action = "back"},
    {x = 12, y = H - 1, label = "[Info]", bg = "blue", fg = "white", action = "info"},
    {x = W - 11, y = H - 1, label = "[" .. nextLabel .. "]", bg = "lime", action = "next"},
  }
  drawFooter("Up/Down select, Space toggle, Enter edit, +/- adjust, N next, B back, I info", btns)
  return btns
end

local function drawSummary()
  local lines = summaryLines()
  drawHeader("Summary: check before Start")
  local visible = H - 5
  if visible < 1 then visible = 1 end
  if summaryScroll < 0 then summaryScroll = 0 end
  if summaryScroll > math.max(0, #lines - visible) then summaryScroll = math.max(0, #lines - visible) end
  for i = summaryScroll + 1, math.min(#lines, summaryScroll + visible) do
    local y = 3 + (i - summaryScroll - 1)
    local fg = "white"
    if lines[i]:sub(1, 7) == "Warning" then fg = "red" end
    put(2, y, lines[i]:sub(1, W - 2), fg, "black")
  end
  local btns = {
    {x = 2, y = H - 1, label = "[Start]", bg = "lime", action = "start"},
    {x = 11, y = H - 1, label = "[Back]", bg = "gray", action = "back"},
    {x = 20, y = H - 1, label = "[Save]", bg = "blue", fg = "white", action = "save"},
    {x = 29, y = H - 1, label = "[Info]", bg = "blue", fg = "white", action = "info"},
  }
  drawFooter("S start, B back, P save preset, I info, Up/Down scroll", btns)
  return btns
end

