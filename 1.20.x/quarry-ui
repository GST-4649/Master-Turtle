-- Gating, mirroring quarry triggers and the approved plan.
local function fieldEnabled(f)
  local k = f.key
  if k == "invert" then return not val("flatBedrock") end
  if k == "startDown" then return not val("flatBedrock") end
  if k == "maxFuel" then return val("fuelChest") end
  if k == "lavaBuffer" then return val("lavaBucket") end
  if k == "quadTimeout" then return val("quad") end
  if k == "quad" then return val("rednet") end
  if k == "gps" then return val("rednet") end
  if k == "sendChannel" or k == "receiveChannel" or k == "fingerprint" then return val("rednet") end
  if k == "preciseTotals" then return val("rednet") end
  if k == "blacklist" or k == "lavaBucket" then return val("oreQuarry") end
  if k == "compareChest" or k == "dumpCompareItems" or k == "extraDropItems" then return val("oldOreQuarry") end
  if k == "startupRename" or k == "startupName" then return val("autoResume") end
  if k == "manualX" or k == "manualZ" or k == "manualY" or k == "manualFacing" then return val("manualPosEnabled") end
  return true
end

local function applyToggles()
  if val("flatBedrock") then setVal("invert", false) end
  if val("quad") then setVal("rednet", true) setVal("gps", true) end
  if not val("rednet") then setVal("quad", false) setVal("gps", false) end
end

local function displayValue(f)
  if f.kind == "bool" or f.kind == "boolForce" then return f.value and "[X]" or "[ ]" end
  return tostring(f.value)
end

-- Preset writer. One parameter per line, quarry -file format.
local function presetLines()
  local lines = {}
  lines[#lines + 1] = "dim " .. tostring(val("length")) .. " " .. tostring(val("width")) .. " " .. tostring(val("height"))
  for _, f in ipairs(fields) do
    if f.key ~= "length" and f.key ~= "width" and f.key ~= "height" and f.key ~= "manualPosEnabled" and f.key ~= "manualX" and f.key ~= "manualZ" and f.key ~= "manualY" and f.key ~= "manualFacing" then
      if f.kind == "boolForce" then
        if f.value then lines[#lines + 1] = f.key end
      elseif f.kind == "bool" then
        lines[#lines + 1] = f.key .. " " .. (f.value and "true" or "false")
      elseif f.kind == "number" or f.kind == "float" then
        if not ((f.key == "sendChannel" or f.key == "receiveChannel" or f.key == "maxFuel" or f.key == "startY" or f.key == "startDown") and f.value == 0) then
          lines[#lines + 1] = f.key .. " " .. tostring(f.value)
        end
      elseif f.kind == "string" then
        if f.value ~= "" then lines[#lines + 1] = f.key .. " " .. f.value end
      end
    end
  end
  if val("manualPosEnabled") then
    lines[#lines + 1] = "manualPos " .. tostring(val("manualX")) .. " " .. tostring(val("manualZ")) .. " " .. tostring(val("manualY")) .. " " .. tostring(val("manualFacing"))
  end
  return lines
end

local function writeFile(path, lines)
  local h = fs.open(path, "w")
  if not h then return false end
  for _, line in ipairs(lines) do h.writeLine(line) end
  h.close()
  return true
end

local function writePreset(path) return writeFile(path, presetLines()) end

local function parseBool(s)
  local c = (tostring(s or "")):sub(1, 1):lower()
  if c == "t" or c == "y" then return true end
  if c == "f" or c == "n" then return false end
  return nil
end

local aliases = {overfuel = "fuelMultiplier", fuelrequestmultiplier = "fuelMultiplier", autorestart = "autoResume", autorestore = "autoResume", lava = "lavaBucket", lavarefuel = "lavaBucket", blacklistfile = "blacklist", extradumpitems = "extraDropItems"}
local function loadPreset(path)
  local h = fs.open(path, "r")
  if not h then return false end
  local text = h.readAll()
  h.close()
  for line in text:gmatch("[^\n]+") do
    line = trim(line)
    if line ~= "" and line:sub(1, 1) ~= "#" then
      local words = {}
      for w in line:gmatch("%S+") do words[#words + 1] = w end
      if #words >= 1 then
        local key = words[1]:gsub("^%-", ""):lower()
        if key == "dim" and #words >= 4 then
          local a, b, c = tonumber(words[2]), tonumber(words[3]), tonumber(words[4])
          if a and a >= 1 then setVal("length", math.floor(a)) end
          if b and b >= 1 then setVal("width", math.floor(b)) end
          if c and c >= 1 then setVal("height", math.floor(c)) end
        elseif key == "manualpos" and #words >= 5 then
          local a, b, c, d = tonumber(words[2]), tonumber(words[3]), tonumber(words[4]), tonumber(words[5])
          if a and b and c and d then
            setVal("manualPosEnabled", true)
            setVal("manualX", math.floor(a)) setVal("manualZ", math.floor(b)) setVal("manualY", math.floor(c)) setVal("manualFacing", math.floor(d))
          end
        else
          key = aliases[key] or key
          local f = byLower[key]
          if f then
            if f.kind == "boolForce" then f.value = true
            elseif f.kind == "bool" and #words >= 2 then local v = parseBool(words[2]) if v ~= nil then f.value = v end
            elseif (f.kind == "number" or f.kind == "float") and #words >= 2 then
              local n = tonumber(words[2])
              if n then
                if f.kind == "number" then n = math.floor(n) end
                f.value = clamp(n, f.minv, f.maxv)
              end
            elseif f.kind == "string" and #words >= 2 then f.value = words[2] end
          end
        end
      end
    end
  end
  applyToggles()
  return true
end

local function listPresets()
  local out = {}
  if fs.list then
    for _, name in ipairs(fs.list("")) do
      if name:sub(-4) == ".txt" and name ~= "current-preset.txt" then out[#out + 1] = name end
    end
    table.sort(out)
  end
  return out
end

local function saveFileAtStart()
